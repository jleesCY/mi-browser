<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">mi</string>
    <string name="shortcut_scan">Scan QR Code</string>
    <string name="shortcut_scan_long">Open camera to scan</string>
    <color name="black">#000000</color>

    <style name="Theme.Mi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Mi</item>
    </style>
</resources>
