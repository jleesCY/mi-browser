<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">mi. Browser</string>
    <color name="black">#000000</color>
    <!-- every mi. app icon sits on this near-black -->
    <color name="icon_background">#0D0D0F</color>

    <style name="Theme.Mi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mi</item>
    </style>
    <string name="widget_search_hint">Search</string>
    <string name="widget_incognito">New incognito tab</string>
    <string name="widget_qr">Scan QR code</string>
    <string name="widget_description">Search the web with mi</string>
    <string name="widget_following">Following</string>
    <string name="widget_following_description">Prices you follow, at a glance</string>
    <string name="widget_following_empty">Nothing Followed Yet</string>
    <string name="widget_following_refresh">Check all prices now</string>
</resources>
