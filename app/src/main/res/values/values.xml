<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">mi</string>
    <color name="black">#000000</color>

    <style name="Theme.Mi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Mi</item>
    </style>
    <string name="widget_search_hint">Search</string>
    <string name="widget_incognito">New incognito tab</string>
    <string name="widget_qr">Scan QR code</string>
    <string name="widget_description">Search the web with mi</string>
</resources>
