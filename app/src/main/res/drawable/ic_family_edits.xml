<?xml version="1.0" encoding="utf-8"?>
<!-- mi. Edits' icon, "You are here": a clapperboard in the app's magenta (#E83E8C), and mi.'s dot is "action", the
     moment it starts. Drawn on a 100-unit grid (the mi-brand icons/make_icons.py base), scaled to 46.7dp and centred on
     the 108dp adaptive canvas. The clapper's stripes and the ring round the dot are the icon background's near-black. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="30.67" android:translateY="30.67" android:scaleX="0.467" android:scaleY="0.467">
        <!-- the glyph 12% larger than its art (mi-brand, 2026-11-27); the dot below keeps its size and place -->
        <group android:pivotX="50" android:pivotY="50" android:scaleX="1.12" android:scaleY="1.12">
            <path android:fillColor="#FFE83E8C" android:pathData="M22,42 H74 A10,10 0 0 1 84,52 V76 A10,10 0 0 1 74,86 H22 A10,10 0 0 1 12,76 V52 A10,10 0 0 1 22,42 Z" />
            <group android:pivotX="12" android:pivotY="34" android:rotation="-14">
                <path android:fillColor="#FFE83E8C" android:pathData="M17,22 H79 A5,5 0 0 1 84,27 V33 A5,5 0 0 1 79,38 H17 A5,5 0 0 1 12,33 V27 A5,5 0 0 1 17,22 Z" />
                <path android:strokeColor="#FF0D0D0F" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M30,22 L24,38" />
                <path android:strokeColor="#FF0D0D0F" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M48,22 L42,38" />
                <path android:strokeColor="#FF0D0D0F" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M66,22 L60,38" />
            </group>
        </group>
        <!-- mi.'s dot (r 12 at 78,78 on every mi. icon), with a ring of background cut round it -->
        <path android:fillColor="#FF0D0D0F" android:pathData="M58,78 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
        <path android:fillColor="#FFE83E8C" android:pathData="M66,78 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    </group>
</vector>
