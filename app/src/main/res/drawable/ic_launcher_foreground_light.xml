<?xml version="1.0" encoding="utf-8"?>
<!-- mi. Browser's Light app icon (Look & Feel › App Icon): ic_launcher_foreground with its cut-outs (the globe's lines, the ring
     round the dot) in the light background's #F5F5F7 instead of the near-black. Same grid, size and place. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="30.67" android:translateY="30.67" android:scaleX="0.467" android:scaleY="0.467">
        <!-- the globe, 12% larger than the 100-unit art about its centre (it reads bigger on the home screen); mi.'s dot keeps its size and place -->
        <group android:pivotX="50" android:pivotY="50" android:scaleX="1.12" android:scaleY="1.12">
        <path android:fillColor="#FF3D9BFF" android:pathData="M12,50 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0 Z" />
        <group>
            <clip-path android:pathData="M12,50 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0 Z" />
            <!-- the equator and two meridians -->
            <path android:strokeColor="#FFF5F5F7" android:strokeWidth="5" android:strokeLineCap="round"
                android:pathData="M12,50 H88 M50,12 C29,31 29,69 50,88 M50,12 C71,31 71,69 50,88" />
        </group>
        </group>
        <!-- you: mi.'s dot (r 12 at 78,78, off-centre at the bottom right on every mi. icon; the globe itself is centred), with a ring of background around it -->
        <path android:fillColor="#FFF5F5F7" android:pathData="M58,78 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
        <path android:fillColor="#FF3D9BFF" android:pathData="M66,78 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    </group>
</vector>
