<?xml version="1.0" encoding="utf-8"?>
<!-- mi. Browser's themed icon (Android 13+ tints it to match the wallpaper): the same globe and dot as
     ic_launcher_foreground, in one colour, with its lines and the ring round the dot truly cut out, since a themed icon
     has only one colour to draw with. Each cut is a clip: everything (the clockwise square) except the cut (wound the
     other way), nested so all four apply. Same 100-unit grid, size and place as the foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="30.67" android:translateY="30.67" android:scaleX="0.467" android:scaleY="0.467">
        <!-- the ring round the dot -->
        <group>
            <clip-path android:pathData="M-10,-10 H110 V110 H-10 Z M58,78 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
            <!-- the equator -->
            <group>
                <clip-path android:pathData="M-10,-10 H110 V110 H-10 Z M0,47.5 V52.5 H100 V47.5 Z" />
                <!-- the left meridian -->
                <group>
                    <clip-path android:pathData="M-10,-10 H110 V110 H-10 Z M47.5,10 C26.5,31 26.5,69 47.5,90 L52.5,90 C31.5,69 31.5,31 52.5,10 Z" />
                    <!-- the right meridian -->
                    <group>
                        <clip-path android:pathData="M-10,-10 H110 V110 H-10 Z M47.5,10 C68.5,31 68.5,69 47.5,90 L52.5,90 C73.5,69 73.5,31 52.5,10 Z" />
                        <path android:fillColor="#FFFFFFFF" android:pathData="M12,50 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0 Z" />
                    </group>
                </group>
            </group>
        </group>
        <!-- you: mi.'s dot -->
        <path android:fillColor="#FFFFFFFF" android:pathData="M66,78 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    </group>
</vector>
