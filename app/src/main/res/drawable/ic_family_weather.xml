<?xml version="1.0" encoding="utf-8"?>
<!-- mi. Weather's icon, "You are here": your cloud in the app's Ice (#A8DCFF), and mi.'s dot is the sun coming out from
     behind it, cut out from the cloud by a ring of the icon's near-black. Drawn on a 100-unit grid (the cloud centred at
     50,50), scaled to 46.7dp and centred on the 108dp adaptive canvas; the cloud is drawn 35% larger than its art (wide and short,
     it needs more than the family's 12% to read as big on the home screen), while mi.'s dot keeps its size and place, as on every mi. icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="30.67" android:translateY="30.67" android:scaleX="0.467" android:scaleY="0.467">
        <!-- the cloud: three puffs on a rounded base (all wound the same way, so their overlaps stay solid), 35% larger than its
             100-unit art about its centre: wide and short, it needs more than other glyphs' 12% to read as big (the user's call) -->
        <group android:pivotX="50" android:pivotY="50" android:scaleX="1.35" android:scaleY="1.35">
            <path android:fillColor="#FFA8DCFF" android:pathData="M17,56 a14,14 0 1,1 28,0 a14,14 0 1,1 -28,0 Z M31,44 a20,20 0 1,1 40,0 a20,20 0 1,1 -40,0 Z M56,56 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0 Z M28,54 H72 A11,11 0 0,1 83,65 A11,11 0 0,1 72,76 H28 A11,11 0 0,1 17,65 A11,11 0 0,1 28,54 Z" />
        </group>
        <!-- mi.'s dot (r 12 at 78,78, the same spot on every mi. icon) with a ring of background around it -->
        <path android:fillColor="#FF0D0D0F" android:pathData="M58,78 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
        <path android:fillColor="#FFA8DCFF" android:pathData="M66,78 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    </group>
</vector>
